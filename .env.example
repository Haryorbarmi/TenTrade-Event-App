# Copy to .env.local and fill in from Supabase: Project Settings -> API.
# Never commit .env.local.

NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# Server only. Used for user management and trusted draw/export actions.
# Never prefix with NEXT_PUBLIC_ and never import it from client code.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# CRM lookup by Client ID. "off" (or unset) = registrars type everything in.
# "fake" = made-up clients for building and rehearsing (see src/lib/crm/fake-clients.ts).
CRM_LOOKUP=off
